[
  {"title":"Inspect scene", "request":{"op":"query","what":"context"}},
  {"title":"Discover API", "request":{"op":"query","what":"api"}},
  {"title":"Select parts (replace example IDs)", "request":{"op":"select","nodes":[1]}},
  {"title":"Frame selection", "request":{"op":"frame","all":false}},
  {"title":"Make a part's material unique", "request":{"op":"apply","command":{"command":"material.unlink","node":1}}},
  {"title":"Change roughness (replace material ID)", "request":{"op":"apply","command":{"command":"material.set_parameter","material":1,"parameter":"specular_roughness","value":0.3}}},
  {"title":"Apply linear RGB color", "request":{"op":"apply","command":{"command":"material.set_parameter","material":1,"parameter":"base_color","value":[0.12,0.25,0.5]}}},
  {"title":"Attach color texture (replace path)", "request":{"op":"apply","command":{"command":"material.set_texture","material":1,"param":"base_color","path":"C:/artwork/color.png","role":"color"}}},
  {"title":"Environment brightness", "request":{"op":"apply","command":{"command":"environment.set_parameter","parameter":"brightness","value":1.5}}},
  {"title":"Add an area light (position afterward)", "request":{"op":"apply","command":{"command":"scene.add_light","name":"Key softbox","light":{"shape":"Area","width":1.0,"height":1.0,"intensity":1000,"intensity_unit":"lm","color":[1,1,1],"enabled":true}}}},
  {"title":"Several edits as one undo step (taken back if any fails)", "request":{"op":"batch","ops":[{"op":"apply","command":{"command":"material.unlink","node":1}},{"op":"select","nodes":[1]},{"op":"frame","all":false}]}},
  {"title":"Camera: a standard view", "request":{"op":"look","view":"front"}},
  {"title":"Camera: orbit angles in degrees", "request":{"op":"look","yaw":35,"pitch":20,"distance":1.5,"focal_length":85}},
  {"title":"Camera: exact eye and target", "request":{"op":"look","from":[0.6,0.4,1.2],"at":[0,0.1,0]}},
  {"title":"Show the Material tab and the rendered viewport", "request":{"op":"ui","tab":"material","viewport":"rendered"}},
  {"title":"Capture just the viewport (deferred)", "request":{"op":"screenshot","path":"C:/projects/viewport.png","viewport":true}},
  {"title":"Background render (does not block)", "request":{"op":"queue","name":"Hero","width":1920,"height":1080,"samples":256}},
  {"title":"Background render progress", "request":{"op":"query","what":"jobs"}},
  {"title":"What undo would take back", "request":{"op":"query","what":"history"}},
  {"title":"Undo last edit or batch", "request":{"op":"undo"}},
  {"title":"Save project (replace path)", "request":{"op":"save","path":"C:/projects/studio.tequila"}},
  {"title":"Capture window (deferred)", "request":{"op":"screenshot","path":"C:/projects/check.png"}},
  {"title":"Render preview (blocks UI)", "request":{"op":"render","path":"C:/projects/preview.png","width":640,"height":480,"samples":16}},
  {"title":"Close Tequila, saving first", "request":{"op":"quit","save":true}}
]
